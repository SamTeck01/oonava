# Site
SITE_URL=https://oonava.com
NEXT_PUBLIC_CALENDLY_URL=            # e.g. https://calendly.com/oonava/mapping-call

# AI (lead analysis + personalised replies)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash          # free tier; use gemini-4-argon for the most capable (paid)

# Email (Resend, domain oonava.com verified)
RESEND_API_KEY=
MAIL_FROM="Oonava <hello@oonava.com>"
TEAM_EMAIL=hello@oonava.com

# CRM (Airtable)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads

# WhatsApp team alerts (CallMeBot). Each person activates CallMeBot on their own phone,
# then add them as phone:apikey pairs, comma-separated:
WHATSAPP_ALERTS=                     # e.g. +447700900123:123456,+2348012345678:654321

# Security
ADMIN_EMAIL=                         # owner login for /admin, e.g. samad@oonava.com
ADMIN_PASSWORD=                      # owner password (long; min 8 characters)

# Optional: team data in Supabase instead of Airtable (run docs/supabase.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTOMATION_SECRET=                   # any long random string (signs unsubscribe links)
CRON_SECRET=                         # any long random string (protects the daily follow-up job)
CALENDLY_WEBHOOK_SIGNING_KEY=
